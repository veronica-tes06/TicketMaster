<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" stopOnFailure="false" executionOrder="random" resolveDependencies="true">

    <php>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3307"/>
        <env name="DB_NAME" value="ticketmaster_test"/>
        <env name="DB_USER" value="root"/>
        <env name="DB_PASS" value=""/>
    </php>

    <testsuites>
        <testsuite name="TicketMaster Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <coverage>
        <report>
            <clover outputFile="build/coverage/clover.xml"/>
        </report>
        <include>
            <directory suffix=".php">app</directory>
        </include>
        <exclude>
            <directory>app/views</directory>
        </exclude>
    </coverage>
</phpunit>
