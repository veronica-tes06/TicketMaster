{
  "$schema": "./vendor/infection/infection/resources/schema.json",

  "source": {
    "directories": [
      "app"
    ],
    "excludes": [
      "app/views",
      "app/config"
    ]
  },

  "phpUnit": {
    "configDir": "."
  },

  "logs": {
    "text": "build/infection/infection-log.txt",
    "html": "build/infection/infection-report.html"
  },

  "mutators": {
    "@default": true
  },

  "minMsi": 40,
  "minCoveredMsi": 60,

  "tmpDir": "build/infection"
}
